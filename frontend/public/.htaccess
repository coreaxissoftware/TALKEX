# Never cache the service worker or the HTML shell. Both must always be
# revalidated on every request — without this, a shared-hosting file
# manager upload (Hostinger, here) can keep serving a browser the OLD
# service-worker.js indefinitely after a real deploy with an actual bug
# fix in it, since the browser's own update check for a service worker is
# itself subject to whatever caching this file's HTTP response allows.
# index.html gets the same treatment for the same reason: it's the one
# file that names which hashed JS/CSS bundle is current.
<IfModule mod_headers.c>
  <FilesMatch "^(service-worker\.js|index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # JS/CSS use fixed (unhashed) filenames, so browsers must revalidate
  # on every visit — the server returns 304 if unchanged, full body if
  # a new deploy landed. Without this, a cached index.js can survive
  # for up to a year and the user never sees the update.
  <FilesMatch "^(?!service-worker\.js$).+\.(js|css|mjs)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
