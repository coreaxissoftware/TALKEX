# Copy to .env for local dev
SECRET_KEY=change_this_to_random_string_in_production
ENVIRONMENT=development
# DATABASE_URL=postgresql://user:pass@localhost/talkex

# Optional: real SMS delivery for phone OTPs (MSG91, using a DLT-approved
# template wired into an MSG91 Flow). Without these, OTPs are just logged
# to the server console. Also settable at runtime from the superadmin
# panel's Integrations tab — no redeploy needed.
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_VAR_NAME=var

# Optional: real email delivery for email OTPs (Mailgun). Without these,
# codes are logged to console. All of this is also settable at runtime from
# the superadmin panel's Integrations tab — no redeploy needed.
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_BASE_URL=https://api.mailgun.net
# MAILGUN_FROM=TalkEx <noreply@your-domain>

# Optional: native Android push (FCM). Without this, fcm.is_configured() is
# False and every push to an Android device is a silent no-op — the app
# still works fine, notifications just never arrive natively (web push is
# unaffected; it uses its own auto-generated VAPID key, not this).
# Paste the ENTIRE contents of a Firebase service-account JSON key file
# (Firebase console → Project settings → Service accounts → Generate new
# private key) as a single-line value.
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}

# Optional: in-app payments (Razorpay). Without these, the /payments/*
# endpoints return 503 and the upgrade prompt in Business Tools shows
# "not configured". Get key + secret from Razorpay Dashboard → Settings
# → API Keys. For testing, use Razorpay's test-mode keys (prefix key_test_).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Optional: LiveKit SFU for scalable group calls. Without these, group calls
# use the built-in peer-to-peer mesh (fine for ≤6 participants; quality degrades
# above that). LiveKit Cloud (livekit.io) or self-hosted (docker run livekit/livekit-server).
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=wss://your-project.livekit.cloud

# Optional: the composer's GIF picker (Tenor). Without this, GET /api/gifs/search
# returns 503 and the picker shows "not set up" instead of results — nothing
# else in the app is affected. Free at https://tenor.com/gifapi/documentation.
# TENOR_API_KEY=

# Optional: inline "Translate" on a received message (Google Cloud Translate).
# Without this, GET /api/translate returns 503 and the action shows "not set
# up" instead of a translation. Get a key from Google Cloud Console
# (Translation API, API key credential — no OAuth needed for this endpoint).
# GOOGLE_TRANSLATE_API_KEY=
