# TalkEx backend environment — copy to <ENV_FILE> (e.g. /etc/talkex/talkex.env),
# fill real values, then: sudo chmod 600 <ENV_FILE> && sudo chown <SERVICE_USER> <ENV_FILE>
# Source of truth for the full list: backend/render.yaml. Copy secret VALUES
# from the Render dashboard (Environment tab).

# --- Core ---
ENVIRONMENT=production
# REUSE the exact SECRET_KEY currently on Render, or every user is logged out.
SECRET_KEY=<COPY_FROM_RENDER>
# Where the SQLite DB + uploads live on the VPS (was /data on Render).
DATA_DIR=/var/lib/talkex
# The web origins allowed to call the API (no trailing slash, comma-separated).
CORS_ALLOWED_ORIGINS=https://talkex.in,https://web.talkex.in
# Superadmin bootstrap + admin account.
SUPERADMIN_USERNAME=<COPY_FROM_RENDER>
ADMIN_PHONE=9113107586

# --- SMS / email OTP (optional; console-log fallback if unset) ---
MSG91_AUTH_KEY=<COPY_FROM_RENDER>
MSG91_TEMPLATE_ID=<COPY_FROM_RENDER>
MAILGUN_API_KEY=<COPY_FROM_RENDER>
MAILGUN_DOMAIN=<COPY_FROM_RENDER>

# --- Native Android push (optional) ---
# Paste the WHOLE Firebase service-account JSON as a single line (or use a path;
# confirm which the code expects). Web push uses the VAPID keys stored in DATA_DIR
# — migrating DATA_DIR preserves them so existing subscriptions keep working.
FCM_SERVICE_ACCOUNT_JSON=<COPY_FROM_RENDER>

# --- Optional integrations ---
TENOR_API_KEY=<COPY_FROM_RENDER>
GOOGLE_TRANSLATE_API_KEY=<COPY_FROM_RENDER>
LIVEKIT_API_KEY=<COPY_FROM_RENDER>
LIVEKIT_API_SECRET=<COPY_FROM_RENDER>
LIVEKIT_URL=<COPY_FROM_RENDER>
